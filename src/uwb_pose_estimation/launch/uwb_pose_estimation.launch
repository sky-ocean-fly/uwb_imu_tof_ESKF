<launch>
  <!-- UWB定位节点 -->
  <node pkg="uwb_pose_estimation" type="uwb_pose_estimation_node" name="uwb_localization_node" output="screen" />

  <node pkg="uwb_pose_estimation"
        type="pose_compare_logger"
        name="pose_compare_logger"
        output="screen">

      <param name="est_topic" value="/estimated_pose"/>
      <param name="gt_topic" value="/mocap_truth_pose"/>

      <param name="csv_path" value="/home/yu/catkin_workspace/dynamic_pose_compare.csv"/>

      <param name="queue_size" value="100"/>
      <param name="sync_slop" value="0.05"/>
  </node>
</launch>

