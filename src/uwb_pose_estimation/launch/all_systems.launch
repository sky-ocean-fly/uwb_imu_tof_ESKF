<launch>

  <!-- 1. IMU + ToF 垂直距离节点 -->
  <include file="$(find imu_mahony)/launch/ground_distance.launch" />

  <!-- 2. UWB LinkTrack 数据解析 -->
  <!-- <include file="$(find nlink_parser)/launch/linktrack_mixed.launch" /> -->

  <!-- 3. 动捕 VRPN 客户端 -->
  <!-- <include file="$(find nlink_parser)/launch/vrpn_client.launch" /> -->

  <!-- 4. UWB 位姿估计节点 -->
  <include file="$(find uwb_pose_estimation)/launch/uwb_pose_estimation.launch" />

  <!-- 5. UWB + IMU + ToF ESKF 融合节点 -->
  <include file="$(find uwb_pose_estimation)/launch/uwb_imu_tof_eskf.launch">
    <arg name="use_fake_imu_a" value="true" />
  </include>

</launch>