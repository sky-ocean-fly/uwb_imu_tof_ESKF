<?xml version="1.0"?>
<package format="2">
  <name>uwb_bias_learning</name>
  <version>0.1.0</version>
  <description>Offline, pose-conditioned bias learning for one directed UWB range pair.</description>

  <maintainer email="you@todo.todo">yu</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>rosbag</depend>
  <depend>rosgraph</depend>
  <depend>rostopic</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nlink_parser</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export/>
</package>
