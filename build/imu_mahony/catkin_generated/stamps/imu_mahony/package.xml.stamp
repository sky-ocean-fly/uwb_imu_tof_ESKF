<?xml version="1.0"?>
<package format="2">
  <name>imu_mahony</name>
  <version>0.0.0</version>
  <description>IMU Mahony Filter &amp; Ground Distance Solver</description>

  <maintainer email="you@todo.todo">yu</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nlink_parser</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nlink_parser</exec_depend>

</package>
