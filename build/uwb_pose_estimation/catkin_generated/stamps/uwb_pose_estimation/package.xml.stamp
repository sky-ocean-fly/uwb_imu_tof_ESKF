<?xml version="1.0"?>
<package format="2">
  <name>uwb_pose_estimation</name>
  <version>0.0.1</version>
  <description>UWB and ToF based real-time relative pose estimation</description>

  <maintainer email="you@todo.todo">yu</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>nlink_parser</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>nlink_parser</exec_depend>

</package>